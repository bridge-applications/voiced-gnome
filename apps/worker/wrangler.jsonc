{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voiced-gnome-worker",
  "account_id": "7007704df82c7db22469f19ad88c711d",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.tesselpunt.com", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "DEMO_ENABLED": "true",
    "DEMO_ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "",
    "DEMO_DAILY_CONVERSATIONS": "60",
    "DEMO_DAILY_TTS_CHARACTERS": "20000",
    "ALLOWED_ORIGINS": "https://tesselpunt.com",
    "ELEVENLABS_AGENT_ID": "agent_2901m41g3g9ff2f8wk8s0z440cr6",
    "MAX_SESSION_SECONDS": "180",
    "STORY_PLANNER_AGENT_ID": "agent_5701m41tf9n7ffvthwe13x968pfz",
    "CHARACTER_AGENT_ID": "agent_7001m4208c01fmeswvbnb03kfe1y",
    "STORY_CHARACTER_AGENT_ID": "agent_4101m41tfbrte1aa8p903qyhb6qf",
  },
  "durable_objects": {
    "bindings": [
      { "name": "DEMO_SESSIONS", "class_name": "DemoSession" },
      { "name": "DEMO_BUDGET", "class_name": "DemoBudget" },
    ],
  },
  "migrations": [
    {
      "tag": "demo-quotas-v1",
      "new_sqlite_classes": ["DemoSession", "DemoBudget"],
    },
  ],
  "env": {
    "local": {
      "secrets": { "required": ["ELEVENLABS_API_KEY", "ABUSE_HASH_SECRET"] },
      "vars": {
        "DEMO_ENABLED": "true",
        "DEMO_ENVIRONMENT": "local",
        "TURNSTILE_SITE_KEY": "",
        "DEMO_DAILY_CONVERSATIONS": "60",
        "DEMO_DAILY_TTS_CHARACTERS": "20000",
        "ALLOWED_ORIGINS": "http://127.0.0.1:5184,http://localhost:5184",
        "CHARACTER_AGENT_ID": "agent_7001m4208c01fmeswvbnb03kfe1y",
        "ELEVENLABS_AGENT_ID": "",
        "MAX_SESSION_SECONDS": "180",
        "STORY_PLANNER_AGENT_ID": "",
        "STORY_CHARACTER_AGENT_ID": "",
      },
      "durable_objects": {
        "bindings": [
          { "name": "DEMO_SESSIONS", "class_name": "DemoSession" },
          { "name": "DEMO_BUDGET", "class_name": "DemoBudget" },
        ],
      },
      "ratelimits": [
        {
          "name": "DEMO_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 8, "period": 60 },
        },
        {
          "name": "SESSION_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 3, "period": 60 },
        },
        {
          "name": "STORY_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 24, "period": 60 },
        },
      ],
    },
  },
  "ratelimits": [
    {
      "name": "DEMO_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 8, "period": 60 },
    },
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
    {
      "name": "STORY_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 24, "period": 60 },
    },
  ],
  "secrets": {
    "required": [
      "ELEVENLABS_API_KEY",
      "ABUSE_HASH_SECRET",
      "TURNSTILE_SECRET_KEY",
    ],
  },
}
